# GEOFF Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ─── Ollama / LLM Backend ──────────────────────────────────────────────────

# Base URL for the Ollama API endpoint.
# Cloud: https://ollama.com/api
# Local: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# API key for the Ollama cloud service.
# Required for cloud profile; leave blank for local Ollama instance.
OLLAMA_API_KEY=

# ─── Geoff API Authentication ──────────────────────────────────────────────

# Optional. If set, all HTTP API endpoints require this key via:
#   X-API-Key: <value>  OR  Authorization: Bearer <value>
# Leave blank to disable API auth (local-only use).
GEOFF_API_KEY=

# ─── Evidence and Case Storage ────────────────────────────────────────────

# Root directory where evidence subdirectories live.
# Geoff will not read evidence outside this path.
# Example: /mnt/evidence  OR  /home/sansforensics/cases
GEOFF_EVIDENCE_PATH=/path/to/evidence

# Directory where Geoff writes per-case work directories.
# Each investigation creates a subdirectory here.
# Example: /tmp/geoff-cases  OR  /mnt/cases
GEOFF_WORK_DIR=/tmp/geoff-cases

# ─── Model Profile ────────────────────────────────────────────────────────

# Which model profile to use: "cloud" or "local"
# cloud — uses hosted models via OLLAMA_URL (requires OLLAMA_API_KEY)
# local — uses locally pulled models (~40 GB; no API key needed)
GEOFF_MODEL_PROFILE=cloud

# Optional per-agent model overrides (leave blank to use profile defaults).
# GEOFF_MANAGER_MODEL=deepseek-v3.2:cloud
# GEOFF_FORENSICATOR_MODEL=qwen3-coder-next:cloud
# GEOFF_CRITIC_MODEL=qwen3.5:cloud

# ─── Logging and Debug ────────────────────────────────────────────────────

# Log verbosity: DEBUG, INFO, WARNING, ERROR
GEOFF_LOG_LEVEL=INFO

# ─── Server Settings ──────────────────────────────────────────────────────

# HTTP server port (default 8080)
# GEOFF_PORT=8080

# Max parallel worker threads for evidence processing (default 4)
# GEOFF_MAX_WORKERS=3
